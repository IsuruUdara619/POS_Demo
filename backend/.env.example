PORT=5000
DATABASE_URL=postgres://username:password@localhost:5432/database_name
JWT_SECRET=your-secret-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Thermal Printer Configuration
THERMAL_PRINTER_NAME=XP-80C

# Sync Configuration
# Each PC must have a unique UUID for NODE_ID. You can generate one from a site like uuidgenerator.net.
# REMOTE_NODE_URL should be the full base URL of the other PC's backend server (e.g., http://192.168.1.101:5000)
NODE_ID=
CENTRAL_API_URL=http://your-central-server.com/api
INTERNAL_SYNC_TOKEN=your-super-secret-token
